EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
EXPO_PUBLIC_API_BASE_URL=https://YOUR_PREVIEW_DOMAIN.vercel.app/api

# Enable the native subscription screen only with the matching server billing
# configuration. Google IDs must come from the actual Play Console catalog.
EXPO_PUBLIC_NATIVE_SUBSCRIPTIONS_ENABLED=false
EXPO_PUBLIC_GOOGLE_PLAY_PRODUCT_ID=
EXPO_PUBLIC_GOOGLE_PLAY_BASE_PLAN_ID=
