{
  "expo": {
    "name": "BaristaMatch",
    "slug": "baristamatch",
    "description": "Connect with local cafés and baristas, discover opportunities, match, and message securely.",
    "scheme": "baristamatch",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fbf7f1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.baristajobmatch.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.baristajobmatch.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fbf7f1"
      }
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
