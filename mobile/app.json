{
  "expo": {
    "name": "BaristaMatch",
    "slug": "baristamatch",
    "description": "Connect with local cafés and baristas, discover opportunities, match, and message securely.",
    "scheme": "baristamatch",
    "version": "1.0.2",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fbf7f1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.baristajobmatch.app",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.baristajobmatch.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fbf7f1"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BaristaMatch to access your photos and videos so you can add them to your profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#b75a1d",
          "defaultChannel": "baristamatch-alerts"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "faef8923-6780-4373-bb0b-c789e3eb1bcc"
      }
    },
    "owner": "tovendy",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/faef8923-6780-4373-bb0b-c789e3eb1bcc"
    }
  }
}
