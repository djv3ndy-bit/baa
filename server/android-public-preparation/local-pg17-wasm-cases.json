  "guards": [
    {
      "name": "sandbox-precondition",
      "setup": "update private.native_billing_configuration set environment='Sandbox';",
      "prefix": ""
    },
    {
      "name": "missing-configuration",
      "setup": "delete from private.native_billing_configuration;",
      "prefix": ""
    },
    {
      "name": "missing-signature",
      "setup": "drop function public.native_checkout_start(uuid,text,uuid);",
      "prefix": ""
    },
    {
      "name": "wrong-column-contract",
      "setup": "alter table public.profiles alter column suspended_at type text using suspended_at::text;",
      "prefix": ""
    },
    {
      "name": "unknown-executor",
      "setup": "",
      "prefix": "set role authenticated;"
    },
    {
      "name": "unexpected-default-grantee",
      "setup": "create role unexpected_default_reader; alter default privileges for role postgres in schema public grant select on tables to unexpected_default_reader;",
      "prefix": ""
    }
  ],
