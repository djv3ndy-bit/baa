# Documentation template only. This file is not automatically loaded.
# These disabled defaults are for a new isolated setup only. Do not overwrite
# existing website or Apple billing flags while preparing Android.
# Never place a private credential in mobile/.env, EXPO_PUBLIC_*, or source control.
NATIVE_PURCHASES_ENABLED=false
NATIVE_GOOGLE_PURCHASES_ENABLED=false
BILLING_ENABLED=false

# Set Sandbox only for the isolated preview database/API and license-test purchases.
# Set Production only for the approved production deployment and production DB.
# The runtime also checks platform-supplied VERCEL_ENV; do not fake that value.
NATIVE_BILLING_ENVIRONMENT=

# Copy actual approved Play Console identifiers. Never reuse or guess Apple IDs.
GOOGLE_PLAY_PRODUCT_ID=
GOOGLE_PLAY_BASE_PLAN_ID=

# Exact public OIDC audience configured on the authenticated Pub/Sub push
# subscription. Recommended form: https://<verified-domain>/api/native-purchases?action=google-events
GOOGLE_PLAY_PUSH_AUDIENCE=
GOOGLE_PLAY_PUSH_SERVICE_ACCOUNT_EMAIL=

# Server-only RSA service-account JSON, supplied through the approved secure
# secret configuration. This is distinct from Firebase google-services.json,
# FCM V1 credentials, and Play submission credentials. Do not commit a real value.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
