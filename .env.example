# Public site URL used for Stripe Checkout and Customer Portal return URLs.
PUBLIC_SITE_URL=https://www.baristajobmatch.com

# Server-only Stripe configuration. Store real values in Vercel as sensitive
# environment variables; never commit them here.
BILLING_ENABLED=false
STRIPE_LIVEMODE=false
STRIPE_RESTRICTED_KEY=
STRIPE_ACCOUNT_ID=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
